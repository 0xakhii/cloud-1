networks:
  cloud1:
    driver: bridge

volumes:
  mariadb_data:
  wordpress_data:

services:
  nginx:
    image: nginx:alpine
    container_name: nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./ssl:/etc/nginx/ssl:ro
      - wordpress_data:/var/www/html:ro
    depends_on:
      - wordpress
      - phpmyadmin
    networks:
      - cloud1
    restart: always

  wordpress:
    image: wordpress:6-fpm
    container_name: wordpress
    volumes:
      - wordpress_data:/var/www/html
    env_file: ./.env
    depends_on:
      - mariadb
    networks:
      - cloud1
    restart: always

  mariadb:
    image: mariadb:10.11
    container_name: mariadb
    volumes:
      - mariadb_data:/var/lib/mysql
    env_file: ./.env
    networks:
      - cloud1
    restart: always

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: phpmyadmin
    env_file: ./.env
    depends_on:
      - mariadb
    networks:
      - cloud1
    restart: always
